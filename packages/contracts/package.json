{
  "name": "@opensource03/llm-gateway-contracts",
  "version": "0.1.0",
  "description": "Public schemas and types for LLM Gateway integrations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSource03/llm-gateway.git",
    "directory": "packages/contracts"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.22.5",
    "typescript": "^7.0.2"
  }
}
