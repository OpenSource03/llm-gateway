GATEWAY_DATABASE_URL=postgresql://llm_gateway:change-me@postgres:5432/llm_gateway
GATEWAY_DATABASE_SSL_MODE=disable
GATEWAY_PUBLIC_URL=http://localhost:8080
GATEWAY_SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
GATEWAY_KEY_WRAPPER=local-rsa
GATEWAY_LOCAL_RSA_KEY_PATH=/run/secrets/llm-gateway-wrap-key.pem
GATEWAY_ROLE=all
GATEWAY_DATA_HOST=0.0.0.0
GATEWAY_DATA_PORT=8080
GATEWAY_CONTROL_HOST=127.0.0.1
GATEWAY_CONTROL_PORT=8081
# Optional private Claude Agent SDK bridge (direct remains the account default):
# GATEWAY_ANTHROPIC_AGENT_SDK_URL=https://agent-sdk.internal
# GATEWAY_ANTHROPIC_AGENT_SDK_API_KEY=replace-with-64-random-hex-characters
# GATEWAY_ANTHROPIC_AGENT_SDK_ALLOW_INSECURE=false
LOG_LEVEL=info
