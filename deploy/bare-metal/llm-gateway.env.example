GATEWAY_PUBLIC_URL=https://gateway.example.com
GATEWAY_LOCAL_RSA_KEY_PATH=/etc/llm-gateway/wrap-key.pem
GATEWAY_SESSION_HMAC_SECRET=replace-with-64-random-hex-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
GATEWAY_UID=1000
GATEWAY_GID=1000
# Optional; direct remains the per-account default:
# GATEWAY_ANTHROPIC_AGENT_SDK_URL=https://agent-sdk.internal
# GATEWAY_ANTHROPIC_AGENT_SDK_API_KEY=replace-with-64-random-hex-characters
# GATEWAY_ANTHROPIC_AGENT_SDK_MODEL_REWRITES_JSON=[]
