[Unit]
Description=LLM Gateway
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/llm-gateway
EnvironmentFile=/etc/llm-gateway/llm-gateway.env
ExecStart=/usr/bin/docker compose -f deploy/compose/compose.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/compose/compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
